<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>listas UL e OL</title>
</head>
<body>
    <h1>listas</h1>
    <h2>lsitas ordenadas</h2>
    <p>Listas com a Tag OL e o TYPE 1</p>
    <ol type="1">
    <li>trabalho de alta performace</li>
    <li>atenção aos detalhes</li>
    <li>conforto e qualidae</li>
    </ol>

    <h2>Listas não ordenadas</h2>
    <p>usando a tag UL</p>
    <ul type="disc">
        <li>agua</li>
        <li>sabao</li>
        <li>queijo</li>
    </ul>
    <h2>misturando  listas</h2>
    <ol>
        <li>user 1 nomes</li>
        <ul> <!--tambem posso colocar a tag OL-->
            <li>Neri</li>
            <li>Alves</li>
        </ul>
    </ol>
    <ol>
        <li>user 2 idades</li>
        <ul>
            <li>17 age</li>
            <li>16 age</li>
        </ul>
    </ol>
    <h2>Listas de definição</h2>
    <dt>HTML
        <dd>A parte base do site</dd>
    </dt>
    <dt>CSS
        <dd>Personalização do site</dd>
    </dt>
    <dt>JAVASCRIPT
        <dd>Interação do site</dd> <!--a lista de definição usa a tag DT e DD, serve para definir alguma coisa
        não e muito utilizado-->
    </dt>
    

