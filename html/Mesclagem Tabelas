<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        table {
            border: 1px solid black;
            border-collapse: collapse;
            width: 300px;
        }
        th, td {
            border: 1px solid black;
            padding: 8px;
            text-align: center;
        }
        th {
            background-color: #f2f2f2;
        }
    </style>
</head>
<body>
    <header>
        <h1>MESCLAGEM DE CELULAS</h1>
    </header>

    <table>
        <tr>
            <td>A</td>
            <td colspan="2">B</td> <!--a celula B vai ocupar 2 linhas da esquerda a direita-->
            
        </tr>
        <tr>
            <td rowspan="3">D</td> <!--a celula D vai ocupar 3 linhas de baixo para cima-->
            <td>E</td>
            <td>F</td>
        </tr>
        <tr>
            
            <td>H</td>
            <td>I</td>
        </tr>
        <tr>
            
            <td>L</td>
            <td>M</td>
        </tr>
    </table>
</body>
</html>
